generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLiteは enum 非対応のため String で表現する
// Priority: "HIGH" | "MID" | "LOW"
// TaskStatus: "PENDING" | "SCHEDULED" | "DONE" | "MISSED"
model Task {
  id              String     @id @default(cuid())
  title           String
  notes           String?
  // AIが付与するカテゴリ (例: "仕事", "勉強", "雑務" など)
  category        String?
  priority        String     @default("MID")
  // AIによる見積もり所要時間 (分)
  estimatedMin    Int?
  // ユーザ指定の期限 (任意)
  dueAt           DateTime?
  // Googleカレンダーに作成された予定のID
  gcalEventId     String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  status          String     @default("PENDING")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// NextAuth標準スキーマ
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
